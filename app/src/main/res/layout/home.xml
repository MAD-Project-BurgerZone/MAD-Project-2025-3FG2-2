<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:id="@+id/main"
    android:background="@color/green">

    <include
        layout="@layout/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/white"
        android:id="@+id/foodItemsScroll">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="300dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/cheeseburg"
                    android:scaleType="centerCrop"
                    android:tint="@color/overlayblack"
                    tools:ignore="UseAppTint" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/white"
                        android:text="DELICIOUS IN EVERY"
                        android:textSize="20sp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/white"
                        android:text="BITE"
                        android:layout_marginTop="-30dp"
                        android:layout_marginBottom="-20dp"
                        android:textSize="100sp"/>

                    <Button
                        android:layout_width="200dp"
                        android:layout_height="50dp"
                        android:layout_marginTop="-20dp"
                        style="@style/StandardButton"
                        android:backgroundTint="@color/lightgreen"
                        android:text="Order Now"
                        android:id="@+id/orderNowBTN"
                        />

                    <Button
                        android:layout_width="200dp"
                        android:layout_height="50dp"
                        style="@style/StandardButton"
                        android:backgroundTint="@color/darkgreen"
                        android:text="Learn more"
                        android:id="@+id/learnMoreBTN"
                        />

                </LinearLayout>

            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginLeft="50dp"
                android:layout_marginRight="50dp"
                android:layout_marginTop="20dp"
                >

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/black"
                    android:text="WELCOME, User!"
                    android:id="@+id/welcomeTXT"
                    android:textStyle="bold"
                    android:textSize="20sp"
                    />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/darkgray"
                    android:text="Lets Start Ordering!"
                    android:layout_marginTop="-3dp"
                    android:textSize="16sp"
                    />

            </LinearLayout>

            <com.google.android.flexbox.FlexboxLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:flexWrap="wrap"
                app:justifyContent="center"
                android:layout_marginTop="20dp"
                android:background="@color/white"
                android:id="@+id/flexboxlayout">

                <!--Items Here-->

            </com.google.android.flexbox.FlexboxLayout>

        </LinearLayout>

    </ScrollView>

    <include
        layout="@layout/navbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

</LinearLayout>