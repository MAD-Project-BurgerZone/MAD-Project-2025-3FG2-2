<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/green"
    android:orientation="vertical"
    tools:context=".controllers.LearnMore">

    <include
        layout="@layout/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/shadedsquare"
        android:backgroundTint="@color/darkgreen"
        android:orientation="vertical"
        android:padding="0dp"
        android:layout_margin="0dp">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/learn_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_rounded"
                android:elevation="6dp"
                android:orientation="vertical"
                android:padding="30dp"
                android:layout_marginLeft="25dp"
                android:layout_marginRight="25dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp"
                >

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:contentDescription="BurgerZone Logo"
                    android:src="@mipmap/burgerzone_logo_green_foreground" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:gravity="center"
                    android:text="BURGERZONE"
                    android:textColor="@color/darkgreen"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="20dp"
                    android:text="Delicious in Every Bite"
                    android:textColor="@color/darkgreen"
                    android:textSize="14sp"
                    android:textStyle="italic" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="20dp"
                    android:layout_marginLeft="20dp"
                    android:layout_marginBottom="40dp"
                    android:text="Welcome to BURGERZONE,
                your ultimate burger craving fixer! We bring the juiciest, freshest, and most mouthwatering burgers straight to your door. Whether you’re a fan of classic cheeseburgers or daring gourmet creations, our app makes ordering fast, easy, and satisfying.
Hot buns. Melty cheese. Perfect delivery. Every time."
                    android:textColor="@color/darkgray"
                    android:textAlignment="center"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="0dp"
                    android:text="DEVELOPERS:"
                    android:textColor="@color/darkgreen"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <!-- Gacosta, John Christian Isaac A  -->
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:layout_marginTop="10dp"
                    android:src="@drawable/_gacosta_picture_background" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:text="Gacosta, John Christian Isaac A."
                    android:textColor="@color/darkgreen"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <!-- Manlapig, John Emmanuel M.  -->
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:layout_marginTop="30dp"
                    android:src="@mipmap/_manlapig_picture_foreground" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:text="Manlapig, John Emmanuel M."
                    android:textColor="@color/darkgreen"
                    android:textSize="16sp"
                    android:textStyle="bold" />


                <!-- Pasacay, Matthew P.  -->
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:layout_marginTop="30dp"
                    android:src="@mipmap/_pasacay_picture_foreground" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:text="Pasacay, Matthew P."
                    android:textColor="@color/darkgreen"
                    android:textSize="16sp"
                    android:textStyle="bold" />


                <!-- Reyes, Reimier R.  -->
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:layout_marginTop="30dp"
                    android:src="@mipmap/_reyes_picture_foreground" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:text="Reyes, Reimier R."
                    android:textColor="@color/darkgreen"
                    android:textSize="16sp"
                    android:textStyle="bold" />


                <!-- Villeno, Peter Alfred DG.  -->
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:layout_marginTop="30dp"
                    android:src="@mipmap/_villeno_picture_foreground" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:text="Villeno, Peter Alfred DG."
                    android:textColor="@color/darkgreen"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="30dp"/>

                <!-- Footer -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="20dp"
                    android:text="© 2025 BurgerZone"
                    android:textColor="@color/darkgreen"
                    android:textSize="14sp" />
            </LinearLayout>

        </ScrollView>

    </LinearLayout>

    <include
        layout="@layout/navbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />


</LinearLayout>